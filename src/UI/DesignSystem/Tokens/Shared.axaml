<!--
  Variant-agnostic design tokens: spacing, radius, typography, motion.
  XAML tier 1 (DESIGN.md §1): a resource dictionary is a framework requirement.
  Values here must never differ between the light and dark ramps.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">

    <!-- Spacing scale (Refactor 3 M0.5 spec) -->
    <x:Double x:Key="SpacingXxs">2</x:Double>
    <x:Double x:Key="SpacingXs">4</x:Double>
    <x:Double x:Key="SpacingSm">8</x:Double>
    <x:Double x:Key="SpacingMd">12</x:Double>
    <x:Double x:Key="SpacingLg">16</x:Double>
    <x:Double x:Key="SpacingXl">20</x:Double>
    <x:Double x:Key="SpacingXxl">24</x:Double>

    <!-- Typography scale (Refactor 10 M2) -->
    <x:Double x:Key="FontSizeXs">11</x:Double>
    <x:Double x:Key="FontSizeSm">12</x:Double>
    <x:Double x:Key="FontSizeMd">13</x:Double>
    <x:Double x:Key="FontSizeLg">15</x:Double>
    <x:Double x:Key="FontSizeXl">18</x:Double>

    <!-- Corner radius scale (Refactor 3 M0.5 spec) -->
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <CornerRadius x:Key="RadiusLg">12</CornerRadius>
    <CornerRadius x:Key="RadiusXl">16</CornerRadius>
    <CornerRadius x:Key="RadiusFull">9999</CornerRadius>

    <!-- Motion policy (DESIGN.md §4): 150-200ms, cubic easing -->
    <system:TimeSpan x:Key="MotionFast">00:00:00.1500000</system:TimeSpan>
    <system:TimeSpan x:Key="MotionNormal">00:00:00.1800000</system:TimeSpan>
    <system:TimeSpan x:Key="MotionSlow">00:00:00.2000000</system:TimeSpan>
</ResourceDictionary>
