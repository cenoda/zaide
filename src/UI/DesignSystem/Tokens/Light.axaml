<!--
  Light ramp. Low-saturation neutrals with a restrained blue accent.
  XAML tier 1 (DESIGN.md §1): a resource dictionary is a framework requirement.
  The key set here must stay identical to Dark.axaml; ThemeTokenParityTests
  enforces this.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette colors -->
    <Color x:Key="PrimaryAccentBrushColor">#1B6FD4</Color>
    <Color x:Key="SecondaryAccentBrushColor">#1E9CB0</Color>
    <Color x:Key="WarningBrushColor">#B87503</Color>
    <Color x:Key="SuccessBrushColor">#1D8348</Color>
    <Color x:Key="SurfaceBaseBrushColor">#F5F6F8</Color>
    <Color x:Key="SurfacePanelBrushColor">#EBEDF2</Color>
    <Color x:Key="PanelDeepBrushColor">#E2E5EA</Color>
    <Color x:Key="SurfaceRaisedBrushColor">#D5DAE3</Color>
    <Color x:Key="TextPrimaryBrushColor">#15171E</Color>
    <Color x:Key="TextSecondaryBrushColor">#525A68</Color>
    <Color x:Key="SeparatorBrushColor">#6B7382</Color>
    <Color x:Key="IdleBrushColor">#737B8A</Color>

    <!-- Palette brushes (derived from the colors above) -->
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="{StaticResource PrimaryAccentBrushColor}" />
    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="{StaticResource SecondaryAccentBrushColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningBrushColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessBrushColor}" />
    <SolidColorBrush x:Key="SurfaceBaseBrush" Color="{StaticResource SurfaceBaseBrushColor}" />
    <SolidColorBrush x:Key="SurfacePanelBrush" Color="{StaticResource SurfacePanelBrushColor}" />
    <SolidColorBrush x:Key="PanelDeepBrush" Color="{StaticResource PanelDeepBrushColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedBrushColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryBrushColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryBrushColor}" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="{StaticResource SeparatorBrushColor}" />
    <SolidColorBrush x:Key="IdleBrush" Color="{StaticResource IdleBrushColor}" />
    <!-- BusyBrush reuses WarningBrushColor (amber) for visual consistency -->
    <SolidColorBrush x:Key="BusyBrush" Color="{StaticResource WarningBrushColor}" />

    <!-- ============ Semantic tokens (Refactor 10 M2) ============ -->

    <!-- Surface: 4 elevation tiers + glass + overlay -->
    <Color x:Key="SurfaceCanvasColor">#F5F6F8</Color>
    <SolidColorBrush x:Key="SurfaceCanvasBrush" Color="{StaticResource SurfaceCanvasColor}" />
    <Color x:Key="SurfaceRaised1Color">#EBEDF2</Color>
    <SolidColorBrush x:Key="SurfaceRaised1Brush" Color="{StaticResource SurfaceRaised1Color}" />
    <Color x:Key="SurfaceRaised2Color">#E2E5EA</Color>
    <SolidColorBrush x:Key="SurfaceRaised2Brush" Color="{StaticResource SurfaceRaised2Color}" />
    <Color x:Key="SurfaceRaised3Color">#D5DAE3</Color>
    <SolidColorBrush x:Key="SurfaceRaised3Brush" Color="{StaticResource SurfaceRaised3Color}" />
    <!-- Translucent white glass over backdrop blur -->
    <SolidColorBrush x:Key="SurfaceGlassBrush" Color="#FFFFFF" Opacity="0.60" />
    <!-- Opaque fallback when blur is unavailable -->
    <Color x:Key="SurfaceGlassFallbackColor">#F0F1F5</Color>
    <SolidColorBrush x:Key="SurfaceGlassFallbackBrush" Color="{StaticResource SurfaceGlassFallbackColor}" />
    <!-- Translucent overlay dim for modal scrims -->
    <SolidColorBrush x:Key="SurfaceOverlayBrush" Color="#FFFFFF" Opacity="0.40" />

    <!-- Border: 1px separators and control borders, plus focus ring -->
    <Color x:Key="BorderSubtleColor">#7F8793</Color>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <Color x:Key="BorderDefaultColor">#5E6A79</Color>
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="{StaticResource BorderDefaultColor}" />
    <Color x:Key="BorderStrongColor">#3F4A5A</Color>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <!-- Translucent accent focus ring -->
    <SolidColorBrush x:Key="BorderFocusBrush" Color="#1B6FD4" Opacity="0.40" />

    <!-- Text: 3-level hierarchy + on-accent + disabled.
         TextPrimaryBrush/TextSecondaryBrush already exist in the palette section
         with identical values, so only the semantic Color aliases are added. -->
    <Color x:Key="TextPrimaryColor">#15171E</Color>
    <Color x:Key="TextSecondaryColor">#525A68</Color>
    <Color x:Key="TextTertiaryColor">#6B7480</Color>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <Color x:Key="TextOnAccentColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccentColor}" />
    <Color x:Key="TextDisabledColor">#A0A7B2</Color>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />

    <!-- Accent: base + hover + pressed + subtle background -->
    <Color x:Key="AccentColor">#1B6FD4</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <Color x:Key="AccentHoverColor">#1560BD</Color>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <Color x:Key="AccentPressedColor">#104F9E</Color>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <Color x:Key="AccentSubtleBgColor">#E8F0FC</Color>
    <SolidColorBrush x:Key="AccentSubtleBgBrush" Color="{StaticResource AccentSubtleBgColor}" />

    <!-- State: status colors + subtle backgrounds.
         SuccessBrush/WarningBrush/IdleBrush already exist in the palette section
         with identical values, so only the semantic Color aliases are added. -->
    <Color x:Key="SuccessColor">#1D8348</Color>
    <Color x:Key="WarningColor">#B87503</Color>
    <Color x:Key="DangerColor">#C53030</Color>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <Color x:Key="InfoColor">#2B6CB0</Color>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <Color x:Key="IdleColor">#737B8A</Color>
    <Color x:Key="SuccessSubtleBgColor">#E6F7ED</Color>
    <SolidColorBrush x:Key="SuccessSubtleBgBrush" Color="{StaticResource SuccessSubtleBgColor}" />
    <Color x:Key="WarningSubtleBgColor">#FFF5E6</Color>
    <SolidColorBrush x:Key="WarningSubtleBgBrush" Color="{StaticResource WarningSubtleBgColor}" />
    <Color x:Key="DangerSubtleBgColor">#FDE8E8</Color>
    <SolidColorBrush x:Key="DangerSubtleBgBrush" Color="{StaticResource DangerSubtleBgColor}" />
    <Color x:Key="InfoSubtleBgColor">#E6F0FA</Color>
    <SolidColorBrush x:Key="InfoSubtleBgBrush" Color="{StaticResource InfoSubtleBgColor}" />
    <Color x:Key="IdleSubtleBgColor">#EEF0F3</Color>
    <SolidColorBrush x:Key="IdleSubtleBgBrush" Color="{StaticResource IdleSubtleBgColor}" />

    <!-- Interaction: translucent hover/pressed/selected overlays -->
    <SolidColorBrush x:Key="OverlayHoverBrush" Color="#000000" Opacity="0.06" />
    <SolidColorBrush x:Key="OverlayPressedBrush" Color="#000000" Opacity="0.10" />
    <SolidColorBrush x:Key="OverlaySelectedBrush" Color="#000000" Opacity="0.08" />

    <!-- Elevation: box shadows -->
    <BoxShadows x:Key="ShadowSm">0 1 2 0 #0D000000</BoxShadows>
    <BoxShadows x:Key="ShadowMd">0 4 6 -1 #1A000000, 0 2 4 -2 #0F000000</BoxShadows>
    <BoxShadows x:Key="ShadowLg">0 10 15 -3 #1A000000, 0 4 6 -4 #0F000000</BoxShadows>

    <!-- AvaloniaEdit SearchPanel override -->
    <SolidColorBrush x:Key="SearchPanelBackgroundBrush" Color="{StaticResource SurfacePanelBrushColor}" />
    <SolidColorBrush x:Key="SearchPanelBorderBrush" Color="{StaticResource SeparatorBrushColor}" />
</ResourceDictionary>
